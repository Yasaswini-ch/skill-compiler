[
  {
    "task_id": "t01",
    "title": "Bug triage: similar summary steps, strict JSON (checkout crash)",
    "skill_file": "skills/bug-report-triage/SKILL.md",
    "input": "Since I updated to version 2.4.1 on Android 13, the app crashes every time I tap Pay on the checkout page. Nobody on my team can place orders now, so our whole sales desk is blocked.",
    "difficulty_tags": [
      "similar_steps",
      "strict_format",
      "hard_limits"
    ],
    "checks": [
      {
        "id": "c1",
        "type": "json_valid",
        "label": "wrong_format"
      },
      {
        "id": "c2",
        "type": "json_keys",
        "value": [
          "bug",
          "impact",
          "version",
          "os",
          "severity",
          "component",
          "fix"
        ],
        "label": "skipped_step"
      },
      {
        "id": "c3",
        "type": "max_words",
        "path": "bug",
        "value": 15,
        "label": "ignored_constraint"
      },
      {
        "id": "c4",
        "type": "max_words",
        "path": "impact",
        "value": 15,
        "label": "ignored_constraint"
      },
      {
        "id": "c5",
        "type": "regex",
        "path": "version",
        "value": "^v2\\.4\\.1$",
        "label": "wrong_format"
      },
      {
        "id": "c6",
        "type": "regex",
        "path": "component",
        "value": "(?i)^payments$",
        "label": "lost_track"
      },
      {
        "id": "c7",
        "type": "regex",
        "path": "impact",
        "value": "(?i)\\b(team|sales|orders?|blocked|unable|cannot|can't)\\b",
        "label": "merged_steps"
      }
    ]
  },
